{
  // เรียกใช้: Ctrl+Shift+P → "Tasks: Run Task" → เลือกงานที่ต้องการ
  "version": "2.0.0",
  "tasks": [
    {
      "label": "เปิดเว็บบนเครื่อง (docker compose up)",
      "type": "shell",
      "command": "docker compose up -d --build",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "detail": "หน้าร้าน http://localhost:8080 · Adminer http://localhost:8081"
    },
    {
      "label": "ปิดเว็บบนเครื่อง (docker compose down)",
      "type": "shell",
      "command": "docker compose down",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "detail": "ข้อมูลในฐานข้อมูลยังอยู่"
    },
    {
      "label": "ทดสอบตรรกะ (npm test)",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "ทดสอบ API ทุก endpoint (ต้องเปิด Docker)",
      "type": "shell",
      "command": "node tests/e2e/api.mjs http://localhost:8080",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "smoke test ด้วย Chrome (ต้องเปิด Docker)",
      "type": "shell",
      "command": "node tests/e2e/smoke.mjs http://localhost:8080",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
