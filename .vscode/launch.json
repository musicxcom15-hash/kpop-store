{
  // กด F5 แล้วเลือก config — เปิด Chrome พร้อม debugger ต่อกับเว็บที่รันใน Docker
  // ต้องรัน docker compose up -d ก่อน (Live Server / express ใช้ไม่ได้แล้ว เพราะรัน PHP ไม่ได้)
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🏠 ทดสอบทั้งเว็บจากหน้าแรก (Docker)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080/index.html",
      "webRoot": "${workspaceFolder}/preorderkpopweb",
      "sourceMaps": true,
      // แยกโปรไฟล์ Chrome ออกมา จะได้ไม่ปนกับ session ที่เปิดใช้งานปกติ
      "userDataDir": "${workspaceFolder}/.vscode/.chrome-debug-profile"
    },
    {
      "name": "🌐 ทดสอบหน้าประวัติการสั่งซื้อ (Docker)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080/order-history.html",
      "webRoot": "${workspaceFolder}/preorderkpopweb",
      "sourceMaps": true,
      "userDataDir": "${workspaceFolder}/.vscode/.chrome-debug-profile"
    }
  ]
}
