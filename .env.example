# =====================================================================
# ตัวแปรที่เว็บใช้ — ตั้งจริงที่ Vercel → Project → Settings → Environment Variables
# (บนเครื่องใช้ docker compose ซึ่งตั้ง DATABASE_URL ให้แล้ว ไม่ต้องมีไฟล์ .env)
# ห้าม commit ค่าจริงของตัวไหนในนี้
# =====================================================================

# ฐานข้อมูล Supabase: Connect → Session pooler (หรือ Transaction pooler พอร์ต 6543) → URI
# รหัสผ่านที่มีอักขระพิเศษต้อง URL-encode
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ที่เก็บไฟล์อัปโหลด (Supabase Storage) — ไม่ตั้ง = เก็บในโฟลเดอร์ uploads/ ของเครื่อง
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_STORAGE_BUCKET=uploads

# production = ซ่อนรายละเอียด error จากหน้าเว็บ
APP_ENV=production

# (ไม่บังคับ) URL ของเว็บสำหรับลิงก์ในอีเมลรีเซ็ตรหัสผ่าน — ไม่ตั้ง = ใช้ VERCEL_PROJECT_PRODUCTION_URL
APP_BASE_URL=

# (ไม่บังคับ) ส่งอีเมลจริง — ไม่ตั้ง = คำขอลืมรหัสผ่านเข้ากล่องแจ้งเตือนแอดมินแทน
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=
